        "rowLabel": "Reference",
        "colLabel": "Number",
        "cols": [
          "One",
          "Many"
        ],
        "rows": [
          {
            "label": "Specific",
            "cells": [
              {
                "sm": "le teine",
                "en": "the girl"
              },
              {
                "sm": "teine",
                "en": "the girls",
                "note": "No article stands before the particular plural."
              }
            ]
          },
          {
            "label": "Non-specific",
            "cells": [
              {
                "sm": "se teine",
                "en": "a girl (any girl)"
              },
              {
                "sm": "ni teine",
                "en": "some girls"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ch6-one-and-many",
      "kind": "contrast",
      "anchor": "one-and-many-the-article-carries-the-number",
      "title": "The article carries the number",
      "caption": "The noun keeps its shape. Dropping *le* changes one particular girl into particular girls.",
      "data": {
        "mode": "toggle",
        "states": [
          {
            "label": "One",
            "sm": "le teine",
            "en": "the girl"
          },
          {
            "label": "Many",
            "sm": "teine",
            "en": "the girls"
          }
        ]
      }
    },
    {
      "id": "ch6-sort-article-phrases",
      "kind": "sort",
      "anchor": "the-non-specific-articles-se-and-ni",
      "title": "Specific or non-specific",
      "intro": "Sort each printed phrase by whether the speaker has a particular thing in mind.",
      "data": {
        "bins": [
          {
            "id": "specific",
            "label": "Specific"
          },
          {
            "id": "non-specific",
            "label": "Non-specific"
          }
        ],
        "items": [
          {
            "sm": "le teine",
            "en": "the girl",
            "bin": "specific",
            "why": "The article *le* marks one particular girl."
          },
          {
            "sm": "le ipu",
            "en": "the cup",
            "bin": "specific",
            "why": "The article *le* marks one particular cup."
          },
          {
            "sm": "se teine",
            "en": "a girl (any girl)",
            "bin": "non-specific",
            "why": "The article *se* marks any single girl, with no particular one chosen."
          },
          {
            "sm": "se mea",
            "en": "a thing, something",
            "bin": "non-specific",
            "why": "The article *se* marks one thing with no particular one chosen."
          },
          {
            "sm": "ni teine",
            "en": "some girls",
            "bin": "non-specific",
            "why": "The article *ni* marks more than one, with no particular ones chosen."
          },
          {
            "sm": "ni mea",
            "en": "some things",
            "bin": "non-specific",
            "why": "The article *ni* marks more than one non-specific thing."
          }
        ]
      }
    },
    {
      "id": "ch6-pick-one-or-many",
      "kind": "pick",
      "anchor": "words-to-learn",
      "title": "One or many?",
      "intro": "Read the English, then choose the Sāmoan that says it. Watch the slot in front of the noun.",
      "data": {
        "question": "Which says this?",
        "prompts": [
          {
            "en": "The girls were happy.",
            "options": [
              {
                "id": "a",
                "sm": "Sā fiafia teine."
              },
              {
                "id": "b",
                "sm": "Sā fiafia le teine."
              }
            ],
            "answer": "a",
            "why": "No article stands in front of *teine*, and that empty slot is the plural. With *le* it is one girl."
          },
          {
            "en": "the tree",
            "options": [
              {
                "id": "a",
                "sm": "le lāʻau"
              },
              {
                "id": "b",
                "sm": "lāʻau"
              }
            ],
            "answer": "a",
            "why": "*Le* marks one particular tree. The bare *lāʻau*, with no article, is the trees."
          },
          {
            "en": "Bring some cups.",
            "options": [
              {
                "id": "a",
                "sm": "ʻAumai ni ipu."
              },
              {
                "id": "b",
                "sm": "ʻAumai se ipu."
              }
            ],
            "answer": "a",
            "why": "*Ni* is the non-specific article for more than one: some cups, however many."
          },
          {
            "en": "Bring a cup.",
            "options": [
              {
                "id": "a",
                "sm": "ʻAumai se ipu."
              },
              {
                "id": "b",
                "sm": "ʻAumai ni ipu."
              }
            ],
            "answer": "a",
            "why": "*Se* is the non-specific article for one thing: a cup, whichever cup is nearest."
          },
          {
            "en": "some girls",
            "options": [
              {
                "id": "a",
                "sm": "ni teine"
              },
              {
                "id": "b",
                "sm": "teine"
              },
              {
                "id": "c",
                "sm": "se teine"
              }
            ],
            "answer": "a",
            "why": "Many and any ones at all takes *ni*. The bare *teine* is particular girls, and *se teine* is one girl."
          },
          {
            "en": "the cup",
            "options": [
              {
                "id": "a",
                "sm": "le ipu"
              },
              {
                "id": "b",
                "sm": "se ipu"
              },
              {
                "id": "c",
                "sm": "ni ipu"
              }
            ],
            "answer": "a",
            "why": "One particular cup takes *le*. *Se* is any one cup, and *ni* is some cups, however many."
          }
        ]
      }
    }
  ]
}
