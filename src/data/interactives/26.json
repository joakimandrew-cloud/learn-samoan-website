      "kind": "pick",
      "anchor": "the-meaning-behind-a-and-o",
      "title": "The owner after the thing: *a* or *o*?",
      "intro": "The thing comes first, then the belonging word, then the owner. Choose the belonging word that fits the English.",
      "data": {
        "question": "Which belonging word?",
        "options": [
          {
            "id": "a",
            "sm": "a"
          },
          {
            "id": "o",
            "sm": "o"
          }
        ],
        "prompts": [
          {
            "sm": "ʻO le leitio ___ le aliʻi.",
            "en": "The radio of the chief.",
            "answer": "a",
            "why": "A chief buys a radio and puts it to use, a relationship he started and controls, so it joins to him with *a*."
          },
          {
            "sm": "ʻO le fale ___ le tama.",
            "en": "The house the boy built.",
            "answer": "a",
            "why": "Under *a*, the house is something the boy made by his own work."
          },
          {
            "sm": "ʻO le fale ___ le tama.",
            "en": "The boy's house (the house he lives in).",
            "answer": "o",
            "why": "Under *o*, the house is the place the boy lives in, not a thing he went out and got."
          },
          {
            "sm": "le naifi ___ le fafine",
            "en": "the woman's knife",
            "answer": "a",
            "why": "A knife is got and put to use, so it takes *a*."
          },
          {
            "sm": "le ulu ___ le gata",
            "en": "the snake's head",
            "answer": "o",
            "why": "A head is a part of the body, and parts of the body take *o*."
          }
        ]
      }
    },
