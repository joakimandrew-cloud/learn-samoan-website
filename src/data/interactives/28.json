    {
      "id": "ch28-make-sleep",
      "kind": "contrast",
      "anchor": "making-something-happen",
      "title": "From sleeping to putting to sleep",
      "caption": "Step through it: the verb, the verb with *faʻa-* in front, then the built word at work in a sentence. The highlight marks what each step adds to the one before.",
      "data": {
        "mode": "steps",
        "states": [
          {
            "label": "The verb",
            "sm": "moe",
            "en": "sleep",
            "note": "*Moe* takes no doer of its own: it names something one person does with nobody else in the sentence."
          },
          {
            "label": "Add *faʻa-*",
            "sm": "faʻamoe",
            "en": "put to sleep",
            "note": "*Faʻa-* goes on the front and never changes its own shape, and the two are written together as one word. The built word means to make somebody do what *moe* names."
          },
          {
            "label": "In a sentence",
            "sm": "Sā faʻamoe e le teine le pepe.",
            "en": "The girl put the baby to sleep.",
            "note": "Now the sentence holds two people: the doer, *le teine*, carrying the agent marker *e*, and the one it was done to, *le pepe*, standing bare after the verb."
          }
        ]
      }
    },
