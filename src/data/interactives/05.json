{
  "chapter": 5,
  "items": [
    {
      "id": "ch5-tense-line",
      "kind": "contrast",
      "anchor": "the-four-tense-particles",
      "title": "One sentence across four particles",
      "caption": "Only the first word changes. The two pasts differ in the shape of the event, rather than how long ago it happened; the other particles report a change or future time.",
      "data": {
        "mode": "steps",
        "states": [
          {
            "label": "*sā*",
            "sm": "Sā ʻou alu.",
            "en": "I went (how things were: I was going, I used to go).",
            "note": "That's how it was: a stretch of time back then."
          },
          {
            "label": "*na*",
            "sm": "Na ʻou alu.",
            "en": "I went (one trip, begun and finished).",
            "note": "It happened: one event, a moment you could point to."
          },
          {
            "label": "*ʻua*",
            "sm": "ʻUa ʻou alu.",
            "en": "I have gone.",
            "note": "It reports a change and usually leaves a new state in place."
          },
          {
            "label": "*ʻoleʻā*",
            "sm": "ʻOleʻā ʻou alu.",
            "en": "I will go.",
            "note": "It places the event ahead of now."
          }
        ]
      }
    },
    {
      "id": "ch5-state-and-change",
      "kind": "contrast",
      "anchor": "the-change-particle-ua",
      "title": "Past state and present change",
      "caption": "The past particle places the earlier state back then. The change particle reports what holds after the change.",
      "data": {
        "mode": "steps",
        "states": [
          {
            "label": "Earlier state",
            "sm": "Sā ia tāuaso.",
            "en": "She was blind."
          },
          {
            "label": "Changed state",
            "sm": "ʻUa ia vaʻai.",
            "en": "Now she sees."
          }
        ]
      }
    },
    {
