          {
            "label": "Ability",
            "sm": "ʻUa mafai ona sau le teine.",
            "en": "The girl can come.",
            "note": "The clause after *ona* names the event. *Mafai* grades it as possible."
          },
          {
            "label": "Obligation",
            "sm": "ʻUa tatau ona sau le teine.",
            "en": "The girl must come.",
            "note": "The same event is graded as necessary by *tatau*."
          }
        ]
      },
      "caption": "Only the word before *ona* changes. The clause naming the coming stays the same."
