      "data": {
        "question": "How is the event graded?",
        "options": [
          {
            "id": "possible",
            "label": "Possible"
          },
          {
            "id": "necessary",
            "label": "Necessary"
          },
          {
            "id": "forbidden",
            "label": "Forbidden"
          }
        ],
        "prompts": [
          {
            "sm": "E sā ona ulaula.",
            "answer": "forbidden",
            "why": "The general particle *e* comes before *sā*, so here *sā* means forbidden rather than past."
          },
          {
            "sm": "ʻUa tatau ona ʻou alu.",
            "answer": "necessary",
            "why": "*Tatau* says that the event in the complement clause is necessary."
          },
          {
            "sm": "E mafai ona siva le uso.",
            "answer": "possible",
            "why": "*Mafai* grades the dancing as possible. The clause after *ona* has no tense particle of its own."
          }
        ]
      },
      "intro": "Choose what the word before the complement says about the event."
    }
